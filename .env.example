# =============================================================================
# SHMS Central Server - Environment Variables (Vercel & Local)
# =============================================================================

# Server Port (Local Dev only; Vercel sets this automatically)
PORT=9000

# Secret Key for JWT Session Tokens and Edge HMAC Verification
SHMS_SECRET_KEY=shms-enterprise-central-secret-key-2026-v1

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use the SERVICE_ROLE_KEY for server-side operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Public Anon Key (optional, can be passed to edge nodes for uploads)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket for Violation Evidence
SUPABASE_BUCKET=evidence-snapshots

# Default Superadmin Credentials (initialized on first run)
SHMS_ADMIN_USER=admin
SHMS_ADMIN_PASS=admin123
